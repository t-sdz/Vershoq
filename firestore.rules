rules_version = '2';

// Règles Vershoq (version sécurisée).
//
// L'app connecte chaque appareil de façon ANONYME au démarrage
// (FirebaseAuth.signInAnonymously, invisible pour l'utilisateur). Toutes les
// opérations exigent donc `request.auth != null` : les données ne sont
// accessibles que depuis l'app, pas depuis l'extérieur.
//
// ⚠️ PRÉREQUIS : activer le fournisseur « Anonyme » dans la console Firebase
// (Authentication > Sign-in method > Anonymous > Activer). Sans ça, l'app ne
// pourra ni lire ni écrire.
//
// On garde en plus une validation de schéma et un plafond de taille des
// photos pour protéger le quota Firebase.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profil utilisateur (nom, pseudo, email, photo base64) : chacun ne
    // peut lire/écrire QUE son propre document.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && (!('photoBase64' in request.resource.data)
            || request.resource.data.photoBase64.size() < 400000);
    }

    match /groups/{groupId} {

      allow read: if signedIn();

      // Création d'un groupe : champs obligatoires et bien typés.
      allow create: if signedIn()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.code is string
                    && request.resource.data.code.size() >= 4
                    && request.resource.data.code.size() <= 12
                    && request.resource.data.createdByEmail is string
                    && (!('photoBase64' in request.resource.data)
                        || request.resource.data.photoBase64.size() < 400000);

      // Mise à jour limitée au compteur de membres, au nom, aux admins et à
      // la photo du groupe (renommage, promotion admin, changement photo).
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['memberCount', 'name', 'admins', 'photoBase64', 'notifConfig'])
                    && (!('photoBase64' in request.resource.data)
                        || request.resource.data.photoBase64.size() < 400000);

      // Pas de suppression de groupe depuis le client.
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.username.size() <= 40
                      && request.resource.data.email is string
                      && (!('photoBase64' in request.resource.data)
                          || request.resource.data.photoBase64.size() < 400000);
        // Un membre peut mettre à jour SA propre fiche (pseudo / photo) pour
        // que le changement se répercute dans le groupe. Uniquement sa fiche
        // (email = son email), et seulement ces champs.
        allow update: if signedIn()
                      && request.auth.token.email == resource.data.email
                      && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['username', 'photoBase64'])
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.username.size() <= 40
                      && (!('photoBase64' in request.resource.data)
                          || request.resource.data.photoBase64.size() < 400000);
        allow delete: if signedIn();
      }

      match /photos/{photoId} {
        allow read: if signedIn();

        // Création d'une photo : schéma validé et image plafonnée à ~700 Ko
        // de base64 (≈ 500 Ko binaire), bien en dessous de la limite de 1 Mo
        // d'un document Firestore.
        allow create: if signedIn()
                      && request.resource.data.imageBase64 is string
                      && request.resource.data.imageBase64.size() > 0
                      && request.resource.data.imageBase64.size() < 700000
                      && request.resource.data.personName is string
                      && request.resource.data.uploaderUsername is string
                      && request.resource.data.uploaderEmail is string
                      && request.resource.data.timestamp is string;

        // Une photo ne se modifie pas, mais peut être supprimée.
        allow update: if false;
        allow delete: if signedIn();
      }
    }
  }
}
